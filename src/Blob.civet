"civet autoLet react jsxCode"
import * as THREE from 'three'
import { useFrame } from "@react-three/fiber"
import { useRef, useState } from 'react'


function f0(xy : THREE.Vector2): THREE.Vector2
  x = xy.x
  y = xy.y
  dx = 0.0
  dy = 0.0
  new THREE.Vector2(dx, dy)

// Pure imaginary eigenvalues.
function f1(xy : THREE.Vector2): THREE.Vector2
  x = xy.x
  y = xy.y
  dx = -y //+ 0.1 * x
  dy = x //- 0.1 * y
  new THREE.Vector2(dx, dy)

function f2(xy : THREE.Vector2): THREE.Vector2
  x = xy.x
  y = xy.y
  r = Math.sqrt(x * x + y * y)
  dx = x + x * y - (x + y) * r;
  dy = y - x * x + (x - y) * r;
  new THREE.Vector2(dx, dy)

function f3(xy : THREE.Vector2): THREE.Vector2
  x = xy.x
  y = xy.y
  r2 = x * x + y * y;
  denom = x * x + y * y * (1 + r2 * r2);
  dx = (x * x * (y - x) + Math.pow(y, 5)) / denom;
  dy = (y * y * (y - 2 * x)) / denom;
  new THREE.Vector2(dx, dy)

f = f2

function step(xys : THREE.Vector2[], delta): THREE.Vector2[]
  for xy of xys
    newXY = xy.clone()
    newXY.add(f(xy).multiplyScalar(delta))
    newXY  

function linspace(start: number, end: number, num: number) : number[]
  step = (end - start) / (num - 1)
  for i of [0...num]
    start + i * step

// The initial and final point should be identical.
function initialBlob (numPoints: number): THREE.Vector2[]
  thetas = linspace(0, Math.PI * 2, numPoints)
  r = 0.95
  for theta of thetas
    new THREE.Vector2
      1.0 + r * Math.cos(theta)
      0.0 + r * Math.sin(theta)

function extend(points: THREE.Vector2[]): THREE.Vector2[]
  // Assume an already closed path, extend by one extra point on each end.
  // (setup for a proper Catmull-Rom interpolation of a closed path)
  [
    points[points.length - 2],
    ...points,
    points[1],
  ]

// This is much better.
// We still have HUGE artifacts when the blob is very thin (numerically, self-
// intersecting maybe), and small one when there are some very acute stuff 
// but it doesn't explode like the previous version.
//
// Wrt thin stuff: *maybe* we could perform some dilation (how ?) before we
// create the shape and see if that solves the issue?
//
// Wrt to thin edge, I don't know what to do. The same kind of thing,
// detect and keep internally the same in the simulation state, but tweak
// in a post-processing phase before creating the shape ? 
// Here the detection ought to be simpler (curvature detection?) but
// dilation may/should solve both issues in one go, if we can figure out how 
// to do it.



export function Blob({ numPoints = 128 })
  meshRef = useRef(null)
  [points, setPoints] = useState initialBlob(numPoints + 1)

  useFrame (state, delta) =>
    new_points = 
      step(points, delta)
      |> extend
      |> new THREE.SplineCurve // Catmull-Rom spline
      // ||> &.arcLengthDivisions = 200 // Higher -> more accurate
      |> .getSpacedPoints (numPoints + 2)
      |> &[1...-1] // Remove the extra points we added for the spline

    setPoints(
        for point of new_points 
          point.clone()
    )
    
    meshRef.current.geometry.dispose()
    meshRef.current.geometry = new_points[...-1]
      |> new THREE.Shape 
      ||> .closePath()
      |> new THREE.ShapeGeometry

  <mesh ref=meshRef>
    <shapeGeometry args=[new THREE.Shape()]>
    <meshStandardMaterial color="black">

